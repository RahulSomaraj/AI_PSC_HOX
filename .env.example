# ---------------------------------------------------------------------------
# PSC Backend - environment variables
# Copy to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Application
# `development` enables TypeORM query logging (app.module.ts) and the
# logging/response interceptors (main.ts). Use `production` on the server.
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# All five are required - the app throws on startup if any is missing.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=psc

# SSL for the DB connection. Anything other than the literal string "false"
# turns SSL on (required for AWS RDS with rds.force_ssl=1).
# Local Postgres normally has no SSL -> set to false.
DB_SSL=false

# Auth
# Secret used to sign/verify JWTs. Required - the app throws if missing.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend
# Base URL used to build password-reset links in EmailService.
FRONTEND_URL=http://localhost:3000

# Activity tracking
# IANA timezone the activity day is bucketed by. Optional, defaults to
# Asia/Kolkata. This is NOT cosmetic: at UTC+5:30 a student active at 01:00
# IST is at 19:30 UTC the day before, so bucketing by UTC would scatter
# late-evening activity across two days and skew the DAU chart.
ACTIVITY_TIMEZONE=Asia/Kolkata

# How often a user's lastSeenAt may be moved forward, in minutes. Optional,
# defaults to 5. Higher means fewer writes and a staler "last active";
# the daily active count is unaffected either way.
ACTIVITY_REFRESH_MINUTES=5

# File uploads (S3 API)
# The API never receives file bytes: it signs a PUT and the client uploads
# straight to storage. Written against the S3 API, not against AWS - set
# S3_ENDPOINT to point the same code at Cloudflare R2, MinIO or Spaces.
#
# S3_BUCKET is the only one that matters: without it POST /uploads answers
# 503 and the rest of the API still boots, so a developer with no bucket is
# not blocked.
S3_BUCKET=
S3_REGION=ap-south-1

# Custom endpoint for an S3-compatible provider. Leave empty for AWS.
# Setting it also switches the client to path-style addressing.
#   R2:    https://<account-id>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
S3_ENDPOINT=

# Credentials. Leave both empty on a deployed box to use the instance role;
# the SDK's default provider chain picks it up.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Base URL returned as `fileUrl`. Set this when a CDN or custom domain sits
# in front of the bucket. Defaults to the bucket's own URL.
S3_PUBLIC_URL=

# How long a signed upload URL stays valid, in seconds. Optional, defaults
# to 300. It only has to cover the upload itself, so keep it short.
UPLOAD_URL_EXPIRY_SECONDS=300
